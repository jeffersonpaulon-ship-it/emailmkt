APP_ENV=production
# Se o app ficar na raiz do domínio: APP_URL=https://seusite.com
# Se o app ficar numa subpasta (ex: seusite.com/rsvp), inclua o caminho: APP_URL=https://seusite.com/rsvp
APP_URL=http://localhost:8000
APP_KEY=change-this-to-a-random-secret-string

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=emailmkt
DB_USER=emailmkt
DB_PASS=change-me

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=user@example.com
SMTP_PASSWORD=change-me
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME="RSVP Events"
